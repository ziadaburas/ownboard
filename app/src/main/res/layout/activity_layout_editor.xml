<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/own_background">

     <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/bg_header_gradient"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">
        
        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
            
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" 
            android:textDirection="rtl"
            android:orientation="vertical">

            <TextView
                
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" تعديل التخطيط"
                android:gravity="right"                
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:layout_gravity="right"
                android:textStyle="bold" />
            
            <TextView
                android:id="@+id/editor_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:layout_gravity="right"
                android:textColor="#DDDDDD"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/img_logo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="16dp" 
            android:padding="8dp"
            android:background="@drawable/border_logo"
            android:src="@drawable/logo_ownboard"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/rows_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@drawable/bg_footer_gradient"
        android:elevation="8dp">

        <Button
            android:id="@+id/btn_add_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+ صف"
            android:background="@drawable/bg_button_own"
            android:backgroundTint="#222222"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_export_json"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="تصدير"
            android:textSize="12sp"
            android:background="@drawable/bg_button_own"
            android:backgroundTint="#222222"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_import_json"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="استيراد"
            android:textSize="12sp"
            android:background="@drawable/bg_button_own"
            android:backgroundTint="#222222"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_reset_lang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="إعادة"
            android:textSize="12sp"
            android:background="@drawable/bg_button_own"
            android:backgroundTint="#222222"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</LinearLayout>
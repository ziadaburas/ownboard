<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/own_background"
    android:orientation="vertical">
   <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="@drawable/bg_header_gradient"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:layoutDirection="ltr"> <!-- لضمان بقاء هذا الترتيب حتى لو تغيرت لغة الهاتف -->
    <Space
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
    <!-- 1. حاوية النصوص أولاً (لتظهر على اليسار) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" 
        android:textDirection="rtl"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الإعدادات العامة"
            android:gravity="right"               
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="#DDDDDD"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- 2. الصورة في النهاية (لتظهر على اليمين) -->
    <ImageView
        android:id="@+id/img_logo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp" 
        android:padding="8dp"
        android:background="@drawable/border_logo"
        android:src="@drawable/logo_ownboard"
        android:scaleType="fitCenter" />

</LinearLayout>

    <!-- تم تغيير الارتفاع إلى match_parent وحذف الوزن -->
    <ScrollView 
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/own_background">

        <LinearLayout
            android:id="@+id/settingsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />

    </ScrollView>
</LinearLayout>